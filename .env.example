# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001
APP_PORT=8000

# LLM provider: groq | gemini   (use the SAME provider+model for both architectures in any comparison)
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# Blank = provider default (T7). Verify IDs with: python scripts/smoke_llm.py
MODEL_NAME=
LLM_TEMPERATURE=0
# gpt-oss / Gemini 2.5 reasoning effort: low | medium | high. Blank = do not send the parameter.
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=4
# Longest single wait we accept from a 429 retry-after header before giving up (seconds)
LLM_RETRY_AFTER_CAP_SECONDS=60
# Minimum seconds between LLM call starts (blank = provider default, T7)
LLM_MIN_INTERVAL_SECONDS=

# Optional tracing (Class 13). Leave blank to disable; the app must work without it.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=procurement-copilot

# Evals
EVAL_API_PORT=8011

# Test hooks (used by evals; leave unset)
# LLM_SIMULATE_OUTAGE=1
# EXTRA_DATA_DIR=evals/fixtures
